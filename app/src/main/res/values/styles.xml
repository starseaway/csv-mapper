<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 卡片内容区通用样式 -->
    <style name="Widget.Demo.CardContent" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">16dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/common_card_bg</item>
    </style>

    <!-- 卡片描述文字通用样式 -->
    <style name="Widget.Demo.CardDesc" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/flux_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <!-- 按钮圆角形状定义 -->
    <style name="Shape.Demo.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <!-- 按钮通用样式 -->
    <style name="Widget.Demo.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="shapeAppearanceOverlay">@style/Shape.Demo.Button</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
        <item name="android:elevation" tools:targetApi="21">0dp</item>
        <item name="android:stateListAnimator" tools:targetApi="21">@null</item>
    </style>

    <!-- 卡片标题行通用样式（横向，垂直居中） -->
    <style name="Widget.Demo.CardTitleRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- 卡片标题文字通用样式 -->
    <style name="Widget.Demo.CardTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/flux_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>